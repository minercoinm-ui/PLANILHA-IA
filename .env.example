# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE — PLANILHA INTELIGENTE IA
# ==============================================================================

# URL base da aplicação hospedada (injetada automaticamente pelo AI Studio / Cloud Run)
APP_URL="MY_APP_URL"

# Chave de API do Gemini para o Analista IA de dados
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# MERCADO PAGO — PAGAMENTOS INSTANTÂNEOS VIA PIX
# ------------------------------------------------------------------------------
# Obtenha seu Access Token de Produção no painel do Mercado Pago:
# https://www.mercadopago.com.br/developers/panel/app
# Se deixado em branco, a aplicação opera automaticamente em modo Sandbox/Homologação
MERCADOPAGO_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# GOVERNANÇA & ACESSO ADMINISTRATIVO
# ------------------------------------------------------------------------------
# E-mail do único administrador autorizado
ADMIN_EMAIL="j14menez@gmail.com"

# Senha administrativa inicial (opcional — se omitida, o sistema utiliza a senha segura gerada no setup)
ADMIN_PASSWORD=""

# Hash bcrypt da senha administrativa (opcional, para implantação sem senhas em texto puro)
ADMIN_PASSWORD_HASH=""

# Segredo criptográfico para assinatura dos cookies HttpOnly de sessão administrativa
ADMIN_SESSION_SECRET="sua_chave_secreta_super_segura_para_assinatura_de_sessoes_2025"

# Caminho explícito do executável FFmpeg no servidor (opcional — detectado automaticamente em /usr/bin/ffmpeg)
FFMPEG_PATH="/usr/bin/ffmpeg"
FFPROBE_PATH="/usr/bin/ffprobe"
